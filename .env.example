# Copie para .env e defina senhas locais aleatórias. Nunca versionar .env.
# Segredo HMAC exclusivo do backend, Base64 de 32 bytes por gerador seguro; nunca EXPO_PUBLIC.
# Vazio localmente usa .patient-auth-key no FILES_DIRECTORY privado.
PATIENT_AUTH_HMAC_KEY=
# Demonstração simplificada: desligada por padrão, apenas servidor loopback/unidade fictícia.
PATIENT_DEMO_LOGIN_ENABLED=false
PATIENT_DEMO_ORGANIZATION_ID=
VIVA_LOGIN_DEMONSTRACAO=false
# SERVER_ADDRESS=127.0.0.1       # Obrigatório ao habilitar o modo acima
# Docker Compose interpola estas variáveis. Maven NÃO lê este arquivo automaticamente.
POSTGRES_DB=vivamais
POSTGRES_USER=vivamais
DATABASE_PASSWORD=
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/vivamais
DATABASE_USER=vivamais
DATABASE_POOL_SIZE=4
PORT=8080
# Provisionamento sintético explícito: perfil bootstrap e senha >=12 caracteres.
DEMO_BOOTSTRAP_PASSWORD=
SPRING_PROFILES_ACTIVE=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081
# API_BASE_URL só no servidor Next; copiar também para web/.env.local.
API_BASE_URL=http://127.0.0.1:8080
APP_ORIGIN=http://127.0.0.1:3000
# URL pública para builds; localhost só para desenvolvimento no mesmo computador.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
EXPO_PUBLIC_PORTAL_URL=http://127.0.0.1:3000
NEXT_PUBLIC_APLICATIVO_URL=http://127.0.0.1:8081
# Somente backend. A chave local é persistida junto aos objetos; preserve ambos no backup.
STORAGE_BACKEND=local
# FILES_DIRECTORY=                 # Caminho absoluto; no Compose usa volume privado
# FILES_ENCRYPTION_KEY=            # Base64 de 32 bytes; manter separada do dump
# Para Supabase, configurar no servidor e validar no fornecedor antes da publicação:
# SUPABASE_URL=
# SUPABASE_STORAGE_BUCKET=viva-private
# SUPABASE_SERVICE_ROLE_KEY=       # NUNCA NEXT_PUBLIC/EXPO_PUBLIC
# OCR nativo no Docker; no host pode utilizar o worker Node já implementado:
# TESSERACT_COMMAND=tesseract
# OCR_NODE_SCRIPT=                # Caminho absoluto de infra/ocr-worker.mjs
# OCR_DATA_DIRECTORY=
# OCR_CACHE_DIRECTORY=
FOOD_ANALYSIS_ENABLED=false
# SMS desabilitado por padrão. Segredos somente no backend, nunca no cliente.
# Rede Android opcional: somente demonstração sintética, dois IPv4 RFC1918 exatos e porta8083.
# Sem estes valores, nenhum conector de rede é aberto; SERVER_ADDRESS continua127.0.0.1.
# PATIENT_DEMO_LAN_ADDRESS=
# PATIENT_DEMO_LAN_CLIENT=
# PATIENT_DEMO_APK_PATH=         # arquivo APK absoluto; somente para o celular de teste autorizado
SMS_PROVIDER=DESABILITADO
SMS_LOCAL_TEST_ENABLED=false
SMS_REAL_AUTHORIZED=false
# SMS_TWILIO_ACCOUNT_SID=
# SMS_TWILIO_AUTH_TOKEN=
# SMS_TWILIO_FROM=
# SMS_TWILIO_MESSAGING_SERVICE_SID=
# FOOD_ANALYSIS_ENDPOINT=         # HTTPS; somente com serviço e critérios aprovados
# FOOD_ANALYSIS_API_KEY=
# FOOD_APPROVED_CRITERIA=
# FOOD_APPROVAL_REFERENCE=

# Testadores sintéticos: habilitar somente em ambiente separado, nunca em produção.
TESTER_ACCESS_ENABLED=false
TESTER_ORGANIZATION_ID=
# Expo: flags públicas de build; nenhum convite ou segredo de backend nestas variáveis.
VIVA_ACESSO_TESTADORES=false
VIVA_ATUALIZACOES=false
EXPO_EAS_PROJECT_ID=
# Homologação remota completa: infra/grupo.env.example e docs/PLANO_DISTRIBUICAO_INTERNA_VIVAMAIS.md

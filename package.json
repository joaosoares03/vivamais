{
  "name": "viva-mais",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.16.0 <25"
  },
  "scripts": {
    "dev:web": "pnpm --filter @viva/web dev",
    "dev:mobile": "expo start",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:mobile",
    "test": "pnpm -r test && pnpm test:mobile",
    "build:web": "pnpm --filter @viva/web build",
    "contracts:generate": "openapi-typescript backend/demo/openapi.json -o packages/contracts/src/generated.ts && prettier --write packages/contracts/src/generated.ts && node infra/sync-shared.mjs",
    "format:check": "prettier --check \"{app,components,contexts,hooks,services,web,packages}/**/*.{ts,tsx,css}\"",
    "lint": "eslint app components contexts hooks services web packages tests/mobile",
    "test:e2e": "playwright test",
    "shared:sync": "node infra/sync-shared.mjs",
    "postinstall": "node infra/sync-shared.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web:mobile": "expo start --web",
    "export:mobile": "expo export --platform web",
    "typecheck:mobile": "tsc --noEmit -p tsconfig.json",
    "test:mobile": "vitest run --config vitest.mobile.config.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "openapi-typescript": "7.10.1",
    "prettier": "3.6.2",
    "@playwright/test": "1.56.1",
    "eslint": "9.39.1",
    "typescript-eslint": "8.46.1",
    "@types/react": "19.2.2",
    "@react-native/metro-config": "0.86.3"
  },
  "dependencies": {
    "tesseract.js": "7.0.0",
    "@expo/metro-runtime": "57.0.17",
    "@tanstack/react-query": "5.90.5",
    "@viva/contracts": "file:./packages/contracts",
    "@viva/design-tokens": "file:./packages/design-tokens",
    "expo": "57.0.21",
    "expo-build-properties": "57.0.22",
    "expo-constants": "57.0.22",
    "expo-linking": "57.0.13",
    "expo-router": "57.0.28",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.0",
    "react-native-worklets": "0.10.1",
    "react-native-reanimated": "4.5.1",
    "expo-notifications": "57.0.17",
    "expo-image-picker": "57.0.16",
    "expo-sqlite": "57.0.2",
    "expo-crypto": "57.0.2"
  },
  "main": "expo-router/entry"
}

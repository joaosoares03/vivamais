{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "contexts/**/*.tsx",
    "hooks/**/*.ts",
    "services/**/*.ts",
    "tests/mobile/**/*.ts",
    "tests/mobile/**/*.tsx",
    "app.config.ts"
  ],
  "exclude": [
    "node_modules",
    "web",
    "backend",
    ".local",
    "referencias_codex",
    "dist"
  ]
}

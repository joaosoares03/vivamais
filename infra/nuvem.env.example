# Railway: segredos de execução, nunca variáveis EXPO_PUBLIC_* / NEXT_PUBLIC_*.
# Entrada do contêiner recusa CPF/nascimento público, SMS, IA e armazenamento efêmero.
APP_ENV=preview
PORT=8080
TESTER_ACCESS_ENABLED=true
TESTER_ORGANIZATION_ID=
PATIENT_DEMO_LOGIN_ENABLED=false
SMS_PROVIDER=DESABILITADO
SMS_LOCAL_TEST_ENABLED=false
SMS_REAL_AUTHORIZED=false
FOOD_ANALYSIS_ENABLED=false
STORAGE_BACKEND=supabase
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=viva-grupo-privado
SUPABASE_SECRET_KEY=
# Alternativa de compatibilidade para chave legada service_role: SUPABASE_SERVICE_ROLE_KEY (não precisa das duas).
# PostgreSQL direto com IPv6 de saída Railway habilitado; pooler Session5432 é alternativa IPv4.
# JDBC tem forma jdbc:postgresql://HOST:5432/postgres?sslmode=verify-full&sslrootcert=/app/.local/certificados/postgres.crt&currentSchema=viva
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=4
DATABASE_CA_CERT_BASE64=
# Gerar separadamente 32 bytes aleatórios/Base64 para cada chave e preservar no cofre do provedor.
FILES_ENCRYPTION_KEY=
PATIENT_AUTH_HMAC_KEY=
# Origem exata HTTPS Railway; incluir a origem exata Vercel após criada. Nunca wildcard.
CORS_ALLOWED_ORIGINS=
# Primeiro deploy em banco NOVO exclusivo pode ativar bootstrap com senha forte gerada privadamente.
# Depois retirar estes dois valores e reiniciar, sem reexecutar seed ou trocar senhas existentes.
SPRING_PROFILES_ACTIVE=
DEMO_BOOTSTRAP_PASSWORD=
# Não definir SERVER_*REMOTEIP*: application-nuvem.yml limita confiança aos pares CGNAT da Railway.

# Vercel, em projeto separado com Root Directory web e fontes de fora da raiz incluídas:
# APP_ENV=preview
# API_BASE_URL=origem HTTPS real Railway
# NEXT_PUBLIC_APLICATIVO_URL=origem HTTPS real Railway
# ENABLE_EXPERIMENTAL_COREPACK=1
# APP_ORIGIN=origem HTTPS real e estável do portal Vercel

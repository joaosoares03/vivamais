# Contexto: raiz do Viva+. O Dockerfile antigo continua atendendo o serviço apenas de API.
FROM node:24.15.0-bookworm-slim AS aplicativo
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages ./packages
COPY patches ./patches
COPY web/package.json ./web/package.json
COPY infra/sync-shared.mjs ./infra/sync-shared.mjs
RUN pnpm install --frozen-lockfile
COPY . .
RUN node infra/construir-web-nuvem.mjs

FROM maven:3.9.11-eclipse-temurin-21 AS api
WORKDIR /workspace
COPY backend/demo/pom.xml .
RUN mvn --batch-mode --no-transfer-progress dependency:go-offline
COPY backend/demo/src ./src
COPY --from=aplicativo /workspace/.local/export-nuvem/ ./src/main/resources/paciente-web/
RUN mvn --batch-mode --no-transfer-progress -DskipTests package

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
RUN apk add --no-cache openssl tesseract-ocr tesseract-ocr-data-eng && addgroup -S viva && adduser -S viva -G viva && mkdir -p /app/.local/private-files /app/.local/certificados && chown -R viva:viva /app/.local
COPY --from=api --chown=viva:viva /workspace/target/viva-mais-api-0.1.0-SNAPSHOT.jar app.jar
COPY --chmod=755 infra/entrada-nuvem.sh /app/entrada-nuvem.sh
USER viva
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=65.0 -XX:InitialRAMPercentage=20.0 -XX:+ExitOnOutOfMemoryError -Duser.timezone=UTC"
EXPOSE 8080
ENTRYPOINT ["/app/entrada-nuvem.sh"]

# Produção do Viva+. Nomes apenas: os valores ficam no cofre do provedor, nunca no Git.
# ValidadorProducao recusa o início se algo aqui estiver ausente ou incompatível.

# Railway (API). Comando de início: /app/entrada-producao.sh
APP_ENV=production
APP_DEMO_ONLY=false
# Referência da autorização de lançamento, por exemplo número da ata ou do chamado.
PRODUCAO_AUTORIZACAO=
FLYWAY_ENABLED=false
APP_MFA_REQUIRED=true
LOGIN_LIMIT_PERSISTED=true
# PRESENCIAL não usa fornecedor. TWILIO exige SMS_REAL_AUTHORIZED=true e as credenciais.
SMS_PROVIDER=PRESENCIAL
SMS_REAL_AUTHORIZED=false
SMS_LOCAL_TEST_ENABLED=false
FOOD_ANALYSIS_ENABLED=false
TESTER_ACCESS_ENABLED=false
PATIENT_DEMO_LOGIN_ENABLED=false
STORAGE_BACKEND=supabase
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=
SUPABASE_SECRET_KEY=
# jdbc:postgresql://HOST:5432/postgres?sslmode=verify-full&sslrootcert=/app/.local/certificados/postgres.crt
DATABASE_URL=
# Papel viva_runtime: nunca o dono das tabelas.
DATABASE_USER=viva_runtime
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=4
DATABASE_CA_CERT_BASE64=
# Três chaves diferentes: 32 bytes aleatórios em Base64, geradas só para produção.
FILES_ENCRYPTION_KEY=
PATIENT_AUTH_HMAC_KEY=
MFA_ENCRYPTION_KEY=
# Origens HTTPS exatas, separadas por vírgula.
CORS_ALLOWED_ORIGINS=

# Só no job de migração: /app/entrada-producao.sh migrar
DATABASE_MIGRATION_USER=viva_migrador
DATABASE_MIGRATION_PASSWORD=

# Só no comando de primeira unidade: /app/entrada-producao.sh provisionar
PROVISAO_UNIDADE=
PROVISAO_EMAIL=
PROVISAO_NOME=
# Caminho de um arquivo novo; o convite é gravado nele e nunca no log.
PROVISAO_SAIDA=

# Vercel (portal), em projeto próprio
# APP_ENV=production
# API_BASE_URL=origem HTTPS da API
# NEXT_PUBLIC_APLICATIVO_URL=origem HTTPS do app
# APP_ORIGIN=origem HTTPS do portal

# Modelo de homologação sintética. Preencher no gerenciador de segredos; não versionar a cópia preenchida.
APP_ENV=preview
TESTER_ACCESS_ENABLED=true
TESTER_ORGANIZATION_ID=
PATIENT_DEMO_LOGIN_ENABLED=false
PATIENT_DEMO_ORGANIZATION_ID=
PATIENT_DEMO_LAN_ADDRESS=
PATIENT_DEMO_LAN_CLIENT=
PATIENT_DEMO_APK_PATH=
SMS_PROVIDER=DESABILITADO
SMS_LOCAL_TEST_ENABLED=false
SMS_REAL_AUTHORIZED=false
FOOD_ANALYSIS_ENABLED=false
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=4
CORS_ALLOWED_ORIGINS=
FILES_ENCRYPTION_KEY=
PATIENT_AUTH_HMAC_KEY=
STORAGE_BACKEND=supabase
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=viva-grupo-privado
SUPABASE_SERVICE_ROLE_KEY=
# Um único bootstrap, em banco novo exclusivo: SPRING_PROFILES_ACTIVE=bootstrap + senha aleatória privada.
# Após criar as contas, retirar o perfil e o segredo bootstrap e reiniciar.
SPRING_PROFILES_ACTIVE=
DEMO_BOOTSTRAP_PASSWORD=
# TLS termina na borda. Só habilitar NATIVE com regex exata dos proxies confiáveis do provedor.
# Valor vazio não confia em nenhum proxy. Não aceitar regex genérica nem cabeçalhos diretamente da internet.
SERVER_FORWARD_HEADERS_STRATEGY=NONE
SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=
